---
import { hero, site } from '../content/site';
---

<header class="top">
  <div class="wrap">
    <div class="logo"><i></i>{site.logo}</div>
    <span class="chip">{site.badge}</span>
    <div class="brand">{site.brandNote}</div>
  </div>
</header>

<div class="wrap hero">
  <h1>{hero.title}</h1>
  <p>{hero.lead}</p>
</div>
