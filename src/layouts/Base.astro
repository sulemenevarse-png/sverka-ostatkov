---
import '../styles/global.css';
import { site } from '../content/site';

// Библиотека чтения Excel лежит в public/ и подгружается только когда пользователь выбрал Excel-файл.
// Путь учитывает base — сайт может жить не в корне домена.
const xlsxSrc = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/vendor/xlsx.full.min.js`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <!-- Демо рассылается по ссылке и не должно попадать в поиск -->
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
  </head>
  <body data-xlsx-src={xlsxSrc}>
    <slot />
    <div class="toast" id="toast" role="status"></div>
    <script>
      import '../client/main.ts';
    </script>
  </body>
</html>
