# Скопируйте этот файл в .env и заполните. Файл .env в репозиторий не попадает.
# Секретов в проекте нет: это статический сайт без сервера. Значения с префиксом PUBLIC_
# попадают в собранную страницу и видны всем — не кладите сюда токены и пароли.

# Куда ведёт кнопка «Хочу так для своего магазина» в подвале (https://…, mailto:… или tel:…).
# Пусто — кнопка скрыта.
PUBLIC_CONTACT_URL=

# Полный адрес сайта, например https://demo.example.ru
SITE_URL=

# Подпапка, если сайт живёт не в корне домена, например /sverka-ostatkov. Для своего домена — оставьте пустым.
BASE_PATH=
