# Пример настройки nginx для статического сайта из папки dist/.
# Замените demo.example.ru на свой домен, пути к сертификатам — на свои
# (бесплатный сертификат выдаёт Let's Encrypt, например через certbot).

# Весь http — на https
server {
    listen 80;
    listen [::]:80;
    server_name demo.example.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name demo.example.ru;

    ssl_certificate     /etc/letsencrypt/live/demo.example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.example.ru/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /var/www/sverka-ostatkov/dist;
    index index.html;

    # Не сообщать версию nginx
    server_tokens off;

    # --- Заголовки безопасности ---
    # HSTS: браузер год ходит на домен только по https. Включайте, когда https точно работает:
    # откатить этот заголовок у уже заходивших посетителей нельзя.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # Та же политика, что в <meta> страницы, плюс frame-ancestors (из <meta> он не работает).
    # connect-src 'none' — страница не может никуда отправить данные из загруженных файлов.
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Файлы в /_astro/ содержат хэш в имени — их можно кэшировать надолго.
    # add_header внутри location отменяет заголовки уровня server, поэтому подключаем их повторно.
    location /_astro/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Сайт только отдаёт файлы: другие методы не нужны
    if ($request_method !~ ^(GET|HEAD)$) {
        return 405;
    }
}
