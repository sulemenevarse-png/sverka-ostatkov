# Образец автосборки для GitHub Pages (серверы за пределами РФ). Основной вариант — хостинг в РФ, см. README.
# Чтобы включить: переложите файл в .github/workflows/deploy.yml,
# выберите Settings → Pages → Source: GitHub Actions. Токену нужно право workflow.
name: Deploy to GitHub Pages

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - run: npm test
      - run: npm audit --audit-level=high
      - run: npm run build
        env:
          # Сайт проекта живёт в подпапке с именем репозитория
          SITE_URL: https://${{ github.repository_owner }}.github.io
          BASE_PATH: /${{ github.event.repository.name }}
          # Ссылка кнопки в подвале: Settings → Secrets and variables → Actions → Variables
          PUBLIC_CONTACT_URL: ${{ vars.PUBLIC_CONTACT_URL }}
      - uses: actions/upload-pages-artifact@v3
        with:
          path: dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
